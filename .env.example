# MiniTools no lee archivos .env ni requiere credenciales.
# Ejemplos de variables opcionales del tooling .NET; el programa no las publica.
DOTNET_CLI_TELEMETRY_OPTOUT=1
# Ruta ficticia para la extracción temporal del ejecutable; normalmente se omite.
DOTNET_BUNDLE_EXTRACT_BASE_DIR=C:/ruta-de-ejemplo/temporal-minitools
